# Copy to .env.local for local work. On the host (e.g. Vercel) add the same names as environment variables.

# The public address of the site, e.g. https://ahmadelwan.dev (no trailing slash).
# Setting this also turns indexing ON. Leave it unset on local and preview builds (they stay noindex).
SITE_URL=

# Contact form. Get a free access key at https://web3forms.com (it is emailed to you). It is public by design.
WEB3FORMS_KEY=

# Alternative to Web3Forms: a Formspree form URL, e.g. https://formspree.io/f/xxxxxxx
FORM_ENDPOINT=
